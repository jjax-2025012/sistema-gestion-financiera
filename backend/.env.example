# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real al repositorio.

# ----- Servidor -----
PORT=3000
CORS_ORIGIN=http://localhost:4200

# ----- PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_financiero
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena

# ----- JWT (JWS) -----
# Cadena larga y aleatoria usada para firmar los tokens. No la compartas.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h
